# Copy to .env.local and provide a local PostgreSQL connection string.
DATABASE_URL=postgresql://workshops_dev:replace-me@127.0.0.1:5432/community_workshops
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Use a separate stable secret in production; BETTER_AUTH_SECRET is the fallback.
# CANCELLATION_TOKEN_SECRET=replace-with-another-random-secret-at-least-32-characters-long
# Configure both values after verifying a sending domain in Resend.
# RESEND_API_KEY=re_replace-me
# EMAIL_FROM=Community Workshops <workshops@updates.example.com>
